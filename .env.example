# CTFd
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Web dashboard access token (optional). If set, every /api/* route requires
# `Authorization: Bearer <token>` (or ?token=<token>). Leave empty to disable
# auth (default) — only do this if the dashboard stays on 127.0.0.1.
WEBUI_TOKEN=

# Total spend cap in USD across all models (optional). 0 = no cap. When
# exceeded, the coordinator LLM and dashboard are warned but nothing is
# auto-killed — you decide whether to stop swarms.
MAX_TOTAL_COST_USD=0
